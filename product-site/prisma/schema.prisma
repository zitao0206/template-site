// V1 数据模型：用户 + 商品 + 购物车
// 开发期用 SQLite（零安装，改文件即可跑）
// 上线切 PostgreSQL 时：provider 改成 "postgresql"，DATABASE_URL 换成 pg 连接串
// 注意：SQLite 不支持 enum，所以 status 用字符串 + 应用层校验（validators.ts）

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String // bcrypt 哈希，绝不存明文
  createdAt DateTime @default(now())

  // 购物车反向关联
  cartItems CartItem[]
  // 订单反向关联
  orders    Order[]
  // 收货地址反向关联
  addresses Address[]
}

model Product {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  price       Int // 单位：分，避免浮点误差
  stock       Int      @default(0) // ✅新增库存，默认0
  imageUrl    String?
  status      String   @default("PUBLISHED") // "PUBLISHED" | "DRAFT"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // 购物车反向关联
  cartItems  CartItem[]
  // 订单明细反向关联
  orderItems OrderItem[]

  @@index([status, createdAt])
}

model CartItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // 同一个用户+同一个商品只能一条购物车记录
  @@unique([userId, productId])
}

// 订单：V3.0.3 起支付成功即落库（真实支付回调在 V4.0 接入）
// status: "PAID"（已支付）；V4 可扩 "PENDING" / "CANCELLED" / "SHIPPED"
model Order {
  id              Int      @id @default(autoincrement())
  orderNo         String   @unique
  userId          Int
  totalAmount     Int // 单位：分，下单时的实付金额
  // PENDING 待处理 / PROCESSING 处理中 / SHIPPED 已发货 / COMPLETED 已结束 / CANCELLED 已取消
  status          String   @default("PENDING")
  cancelReason    String? // 管理员取消订单时的留言（用户可见）
  trackingNo      String? // 发货单号
  // 收货信息快照（下单时写入，后续改地址不影响历史订单）
  receiverName    String?
  receiverPhone   String?
  receiverZip     String?
  receiverAddress String?
  createdAt       DateTime @default(now())

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items OrderItem[]

  @@index([userId, createdAt])
}

// 订单明细：冗余存 title / price 快照，商品后续改价改名不影响历史订单
model OrderItem {
  id        Int    @id @default(autoincrement())
  orderId   Int
  productId Int
  title     String
  price     Int // 单位：分
  quantity  Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// 收货地址：一个用户可以有多条，管理页可增删
model Address {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String // 收件人姓名
  phone     String // 联系电话
  zipCode   String // 邮政编码
  detail    String // 详细地址
  isDefault Boolean  @default(false) // 是否默认地址（同一用户至多一条）
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
