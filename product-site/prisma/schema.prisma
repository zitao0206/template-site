// V1 数据模型：用户 + 商品 + 购物车
// 开发期用 SQLite（零安装，改文件即可跑）
// 上线切 PostgreSQL 时：provider 改成 "postgresql"，DATABASE_URL 换成 pg 连接串
// 注意：SQLite 不支持 enum，所以 status 用字符串 + 应用层校验（validators.ts）

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String // bcrypt 哈希，绝不存明文
  createdAt DateTime @default(now())

  // 购物车反向关联
  cartItems CartItem[]
}

model Product {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  price       Int // 单位：分，避免浮点误差
  stock       Int      @default(0)  // ✅新增库存，默认0
  imageUrl    String?
  status      String   @default("PUBLISHED") // "PUBLISHED" | "DRAFT"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, createdAt])

  // 购物车反向关联
  cartItems CartItem[]
}

model CartItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // 同一个用户+同一个商品只能一条购物车记录
  @@unique([userId, productId])
}
