// V1 数据模型：用户 + 商品
// 开发期用 SQLite（零安装，改文件即可跑）
// 上线切 PostgreSQL 时：provider 改成 "postgresql"，DATABASE_URL 换成 pg 连接串
// 注意：SQLite 不支持 enum，所以 status 用字符串 + 应用层校验（validators.ts）

// prisma/user/schema.prisma

generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/user-client"   // ★ 必须各自指定输出目录
}
datasource db {
  provider = "sqlite"
  url      = env("USER_DATABASE_URL")
}
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}