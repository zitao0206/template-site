# 数据库：开发期用 SQLite，文件会自动生成在 prisma/dev.db
# 上线切 PostgreSQL 示例：
# DATABASE_URL="postgresql://user:pass@host:5432/dbname?schema=public"
DATABASE_URL="file:./dev.db"

# JWT 签名密钥（务必换成随机字符串，可用 openssl rand -hex 32 生成）
JWT_SECRET="change-me-to-a-random-32-byte-hex"

# 管理员账号（写死，不进数据库）
# 密码哈希用 `npm run gen:hash -- 你的密码` 生成后填进来
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD_HASH=""
